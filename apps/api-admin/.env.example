# Back-office API. `pnpm dev` and `pnpm start` load ./.env through Node (--env-file-if-exists);
# variables set in the shell win over the file, but the root `pnpm dev` runs through turbo, whose
# strict env mode drops shell variables such as PORT: set them here, or run `pnpm dev` inside
# apps/api-admin. Never commit a real .env.
NODE_ENV=development
# HTTP port; the web-admin Vite proxy and Caddy forward /api here.
PORT=3001
# Interface to listen on. Unset: 127.0.0.1 in development (not reachable from the LAN), 0.0.0.0 in
# test and production (containers).
# HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# JSON log files next to stdout (D14); set false where the platform collects stdout.
LOG_FILE_ENABLED=true
# Files: LOG_DIR/api-admin/api-admin.<yyyy-MM-dd>.<n>.log, relative to the app directory.
LOG_DIR=logs
# Rotated files kept per app (1-365).
LOG_RETENTION_DAYS=14
# PostgreSQL connection (required); compose sets its own value for the containers.
DATABASE_URL=postgresql://tms:tms@localhost:5432/tms
# Upper bound in ms of the database ping behind GET /api/health (100-10000).
HEALTH_DB_TIMEOUT_MS=1000
# Express `trust proxy`: false, a hop count or a preset/subnet list; compose uses Caddy's subnet.
TRUST_PROXY=loopback
# Comma list of origins the web-admin SPA may call from (D11 OriginGuard).
ADMIN_WEB_ORIGINS=http://localhost:5173
# Staff session cookie: idle timeout, absolute lifetime and whether the cookie is Secure
# (SESSION_COOKIE_SECURE=false is rejected when NODE_ENV=production).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_COOKIE_SECURE=true
# Outgoing mail (invite, password reset, 2FA reset): SMTP URL and the From header; compose points
# SMTP_URL at the mailpit service.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TMS <no-reply@tms.local>
# Base URL of the web-admin SPA; mailed links (invite, password reset, 2FA reset) are built on it.
ADMIN_WEB_URL=http://localhost:5173
# Hours an invite link stays valid (1-336).
INVITE_TTL_HOURS=72
# TOTP secret encryption keyring (`keyId:base64(32 bytes)` pairs, comma-separated) and the id of
# the key used to encrypt new secrets; generate real values with `openssl rand -base64 32` and
# rotate by adding a new pair, then switching the active id once every secret has been re-encrypted.
# The dev defaults below are rejected when NODE_ENV=production.
SECRETS_ENC_KEYS=dev1:ZGV2LW9ubHktc2VjcmV0cy1lbmMta2V5LTMyLWJ5dGU=
SECRETS_ENC_ACTIVE_KEY_ID=dev1
# Argon2id pepper (base64, >= 32 bytes); generate with `openssl rand -base64 32`. Rejected in
# production when it still has the dev default below.
PASSWORD_PEPPER=ZGV2LW9ubHktcGFzc3dvcmQtcGVwcGVyLTMyYnl0ZXM=
# Issuer name shown in the authenticator app.
TOTP_ISSUER=TMS
# Account lockout: failed attempts before a lock, base lock duration (doubles per consecutive
# lock) and its cap, in seconds.
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=900
LOCKOUT_MAX_SECONDS=3600
# Rate limits on auth routes (@nestjs/throttler): requests per IP and per account, and their
# windows in seconds.
THROTTLE_AUTH_IP_LIMIT=30
THROTTLE_AUTH_IP_TTL_SECONDS=60
THROTTLE_AUTH_ACCOUNT_LIMIT=10
THROTTLE_AUTH_ACCOUNT_TTL_SECONDS=900
# Sentry: an empty DSN disables it (the SDK is not even initialised).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Set to the git SHA by the image build (GIT_SHA build argument); leave empty locally.
SENTRY_RELEASE=
