# POSTGRES_PASSWORD and POSTGRES_PORT are also part of DATABASE_URL in packages/db/.env; change both.
POSTGRES_PASSWORD=tms
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
CADDY_ADMIN_PORT=8080
CADDY_KIOSK_PORT=8081

# Bootstrap administrator the migrate one-shot creates (INVITED) while no admin exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin

# Sentry for the API containers; empty = disabled. The release is the GIT_SHA build argument.
SENTRY_DSN=
# Environment shown in Sentry; empty falls back to NODE_ENV (production in compose).
SENTRY_ENVIRONMENT=

# TOTP secret encryption keyring and Argon2id pepper for the `full` profile (NODE_ENV=production,
# so api-admin's dev defaults are rejected). local compose and CI only — replace for any shared environment
SECRETS_ENC_KEYS=stack1:c3RhY2sxLWNvbXBvc2UtY2ktc2VjcmV0cy1rZXktMzI=
SECRETS_ENC_ACTIVE_KEY_ID=stack1
PASSWORD_PEPPER=c3RhY2sxLWNvbXBvc2UtY2ktcGVwcGVyLTMyYnl0ZXM= # gitleaks:allow (public CI value)
