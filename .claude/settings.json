{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm hygiene:*)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm compose ps:*)",
      "Bash(pnpm compose logs:*)",
      "Bash(pnpm compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(git branch --show-current)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test)",
      "Bash(pnpm run verify)"
    ],
    "deny": [
      "Edit(/docs/client/**)",
      "Edit(/.env)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.development)",
      "Edit(/**/.env.test)",
      "Edit(/**/.env.production)",
      "Edit(/**/.env.*.local)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env*.example)",
      "Read(!.env*.sample)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env*.example)",
      "Edit(!.env*.sample)"
    ]
  },
  "extraKnownMarketplaces": {
    "ethernal": {
      "source": {
        "source": "github",
        "repo": "Ethernal-Tech/claude-playbook"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "core@ethernal": true,
    "nestjs@ethernal": true,
    "react@ethernal": true,
    "sql@ethernal": true,
    "typescript@ethernal": true,
    "superpowers@claude-plugins-official": true
  }
}
